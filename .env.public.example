# این فایل را به .env.public کپی کنید و مقدارها را با رمزهای تصادفی عوض کنید.
# .env.public در git ثبت نمی‌شود. فقط از حروف و اعداد انگلیسی استفاده کنید.
POSTGRES_PASSWORD=change-me-hex-only
# حداقل ۳۲ نویسه
RAZI_JWT_SECRET=change-me-at-least-32-characters-long
# کلید Fernet (۴۴ نویسه base64)
RAZI_DATA_ENCRYPTION_KEY=change-me
# رمز ورود کاربران نمایشی 1001 تا 1005؛ حداقل ۱۰ نویسه و غیر از Razi1234
RAZI_DEMO_PASSWORD=change-me
