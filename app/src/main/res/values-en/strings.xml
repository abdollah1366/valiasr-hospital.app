    <string name="about_title">About the hospital</string>
    <string name="about_body">Valiasr International Hospital in Tabriz, the largest private hospital in Iran, offers a wide range of specialist and subspecialist diagnostic, treatment and rehabilitation services.</string>
    <string name="about_sub">24/7 emergency, 77 ICU beds and 14 operating rooms</string>
    <string name="about_er_n">24/7</string>
    <string name="about_er">Emergency department</string>
    <string name="about_er_visits">Over 4,000 visits a month</string>
    <string name="about_icu_n">77</string>
    <string name="about_icu">ICU beds</string>
    <string name="about_ccu_n">8</string>
    <string name="about_ccu">CCU beds</string>
    <string name="about_or_n">14</string>
    <string name="about_or">Modern operating rooms</string>
    <string name="about_diag_title">Diagnosis and treatment</string>
    <string name="about_diag">CT, MRI, PET scan, nuclear medicine, radiology, chemotherapy and radiotherapy, endoscopy and outpatient care</string>
    <string name="about_special_title">Specialised services</string>
    <string name="about_special">Infertility treatment, sleep disorders, chronic pain and hard-to-treat conditions</string>
    <string name="about_depts_title">Specialist departments</string>
    <string name="about_depts">Cardiology, maternity and newborn care, neurology, gastroenterology and hepatology, orthopaedics, urology, oncology, nephrology, infectious diseases, pulmonology, ENT, IVF and advanced surgery</string>
    <string name="about_approach">Our approach is fully patient-centred: from calming modern architecture to smart appointments and electronic records, everything is designed for a safe and reassuring experience.</string>
