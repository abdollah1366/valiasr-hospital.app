    <string name="about_title">Xəstəxana haqqında</string>
    <string name="about_body">Təbriz Beynəlxalq Vəliəsr Xəstəxanası İranın ən böyük özəl xəstəxanası olaraq geniş çeşiddə ixtisaslaşmış və yüksək ixtisaslaşmış diaqnostika, müalicə və reabilitasiya xidmətləri göstərir.</string>
    <string name="about_sub">Gecə-gündüz təcili yardım, 77 ICU çarpayısı və 14 əməliyyat otağı</string>
    <string name="about_er_n">24/7</string>
    <string name="about_er">Təcili yardım şöbəsi</string>
    <string name="about_er_visits">Ayda 4000-dən çox müraciət</string>
    <string name="about_icu_n">77</string>
    <string name="about_icu">ICU çarpayısı</string>
    <string name="about_ccu_n">8</string>
    <string name="about_ccu">CCU çarpayısı</string>
    <string name="about_or_n">14</string>
    <string name="about_or">Müasir əməliyyat otağı</string>
    <string name="about_diag_title">Diaqnostika və müalicə</string>
    <string name="about_diag">KT, MRT, PET-skan, nüvə təbabəti, radiologiya, kimyaterapiya və radioterapiya, endoskopiya və ambulator xidmət</string>
    <string name="about_special_title">Xüsusi xidmətlər</string>
    <string name="about_special">Sonsuzluğun müalicəsi, yuxu pozuntuları, xroniki ağrılar və çətin müalicə olunan xəstəliklər</string>
    <string name="about_depts_title">İxtisaslaşmış şöbələr</string>
    <string name="about_depts">Kardiologiya, ana və yenidoğulmuş, nevrologiya, qastroenterologiya və hepatologiya, ortopediya, urologiya, onkologiya, nefrologiya, infeksion xəstəliklər, pulmonologiya, LOR, IVF və müasir cərrahiyyə</string>
    <string name="about_approach">Yanaşmamız tamamilə pasiyentyönümlüdür: sakitləşdirici müasir memarlıqdan ağıllı növbə sistemi və elektron tibbi qeydlərə qədər hər şey təhlükəsiz və rahat təcrübə üçün hazırlanıb.</string>
    <string name="contact_instagram">Instagram</string>
    <string name="contact_telegram">Telegram</string>
    <string name="admission_title">Qəbul bələdçisi</string>
    <string name="admission_sub">Yatırılma mərhələləri və özünüzlə nə gətirməli</string>
    <string name="admission_steps_title">Yatırılma mərhələləri</string>
    <string name="step1">Müalicə həkiminiz yatırılma göstərişi verir</string>
    <string name="step2">Qəbul şöbəsinə müraciət</string>
    <string name="step2_detail">Yatırılma göstərişi və şəxsiyyət vəsiqəsi yoxlanılır, təxmini xərc, depozit və əlavə sığorta izah edilir, sol qolunuza identifikasiya qolbağı taxılır və əməliyyatdan əvvəl anestezioloqa göndərilirsiniz</string>
    <string name="step3">Pasiyentlərə dəstək şöbəsinə müraciət</string>
    <string name="step3_detail">Qarşılanma, Sapiba maarifləndirmə sistemi ilə tanışlıq, aptekdən lazımi ləvazimatın alınmasında kömək və şöbəyə köçürülmənin təşkili</string>
    <string name="step4">Şöbədə qəbul</string>
    <string name="step4_detail">Şöbə katibi və ya tibb bacısı sizi qəbul edir və ilkin tibb bacısı qiymətləndirməsi aparılır</string>
    <string name="step5">Yatırılma və müalicənin başlanması</string>
    <string name="admission_tips_title">Vacib qeydlər</string>
    <string name="tip1">Diaqnostik sənədlərinizi özünüzlə gətirin.</string>
    <string name="tip2">Qəbul zamanı gigiyena vasitələri və xəstə paltarı olan xəstəxana dəsti verilir; yorğan, mələfə və qab-qacaq otaqda var, ona görə minimum əşya ilə gəlin.</string>
    <string name="tip3">Xəstəxananın lobbisində mağazalar var.</string>
    <string name="tip4">Qəbul zamanı təxmini məbləğ depozit kimi alınır; çıxış zamanı yekun hesab bir qədər dəyişə bilər.</string>
    <string name="tip5">Xəstəxana bütün sığorta fondları ilə müqavilə bağlayıb; qəbul sığortanızın növünə görə aparılır.</string>
    <string name="tip6">Hər pasiyent üçün yalnız bir parklanma yeri ayrılır; ərazidə bir avtomobildən artıq gətirməyin.</string>
    <string name="tip7">Yatırılmanın əvvəlindən qəbul şöbəsindən xərclər haqqında tam məlumat alın və suallarınızı müalicədən əvvəl verin.</string>
</resources>
