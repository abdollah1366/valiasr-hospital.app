# این فایل را به .env کپی و مقادیر را عوض کنید. فایل .env هرگز commit نشود.
RAZI_ENV=development
RAZI_DATABASE_URL=postgresql+psycopg://razi:razi@localhost:5432/razi
# در محیط عملیاتی: یک رشته تصادفی بلند (حداقل ۳۲ نویسه)
RAZI_JWT_SECRET=change-me
# در محیط عملیاتی: خروجی  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
RAZI_DATA_ENCRYPTION_KEY=
# مدیر اولیه سیستم (فقط بار اول ساخته می‌شود و باید رمز را عوض کند)
RAZI_BOOTSTRAP_ADMIN_CODE=admin
RAZI_BOOTSTRAP_ADMIN_PASSWORD=
